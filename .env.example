# ==============================================================================
# VIRALCLIP STUDIO — ENVIRONMENT CONFIGURATION
# Decoupled Vercel (Web / APIs) + Database + Object Storage + Processing Worker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & HOSTING
# ------------------------------------------------------------------------------
# PORT: Local Express server port in development (default: 3001)
PORT=3001

# NODE_ENV: 'development' | 'production' | 'test'
NODE_ENV=development

# APP_URL: The canonical public URL of the deployed application
APP_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL / Supabase / Neon connection string for persistent projects,
# user metadata, and job state.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viralclip_studio?sslmode=prefer"

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE CONFIGURATION (S3 / Cloudflare R2 / GCS)
# ------------------------------------------------------------------------------
# STORAGE_DRIVER: 'local' (development under data/media) or 's3' / 'r2' (production)
STORAGE_DRIVER=local

# S3 / Cloudflare R2 Bucket Name
S3_BUCKET="viralclip-media"

# AWS Region or 'auto' for Cloudflare R2
S3_REGION="us-east-1"

# Custom Endpoint (Required for Cloudflare R2 or MinIO, optional for AWS S3)
# Example for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# S3 Access Key ID (Never expose via VITE_)
S3_ACCESS_KEY_ID="your_s3_access_key_id"

# S3 Secret Access Key (Never expose via VITE_)
S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"

# STORAGE_PUBLIC_URL: Optional CDN base URL for serving uploaded media & exports
# Example: https://cdn.viralclip.studio
STORAGE_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 4. PROCESSING WORKER ARCHITECTURE (Dedicated FFmpeg / Whisper Worker)
# ------------------------------------------------------------------------------
# PROCESSING_MODE: 'local' (runs local binaries via child_process) or 'worker' (dispatches to remote worker)
PROCESSING_MODE=local

# WORKER_URL: URL of the dedicated media processing worker instance (e.g. Fly.io, Railway, EC2)
# Example: https://worker.viralclip.studio
WORKER_URL=""

# WORKER_SECRET: Pre-shared secret token for authenticating worker API requests (Bearer auth)
WORKER_SECRET="generate_a_secure_random_worker_secret_key"

# ------------------------------------------------------------------------------
# 5. AI PROVIDER KEYS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for semantic analysis, hook generation, and multimodal AI
GEMINI_API_KEY=""

# WHISPER_MODEL: Model size for local Whisper ('tiny', 'base', 'small', 'medium')
WHISPER_MODEL="base"

# Optional Third-Party Stock Providers (Pexels, Unsplash, Pinterest)
PEXELS_API_KEY=""
PINTEREST_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# AUTH_SECRET / JWT_SECRET: Secret for signing session cookies or JWT tokens
AUTH_SECRET="generate_a_secure_session_encryption_secret"
JWT_SECRET="generate_a_secure_jwt_signing_secret"

# ------------------------------------------------------------------------------
# 7. CLIENT PUBLIC CONFIGURATION (Safe for browser injection)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Leave empty when frontend and API are hosted on the same origin (standard Vercel)
VITE_API_BASE_URL=""

# VITE_APP_TITLE: Public application display title
VITE_APP_TITLE="ViralClip Studio"
