# ==============================================================================
# VIRALCLIP STUDIO — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Target Architecture: Vercel (Web / API) + PostgreSQL + S3/R2 Storage + Worker
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION HOSTING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"
VITE_API_BASE_URL=""
VITE_APP_TITLE="ViralClip Studio"

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL — Supabase, Neon, AWS RDS, Railway, or local Docker)
# Required in production. In local development without DATABASE_URL, disk journaling is used.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres_secret_password@localhost:5432/viralclip_studio?sslmode=prefer"
PGSSLMODE="prefer"

# ------------------------------------------------------------------------------
# DURABLE QUEUE & CACHE (Redis — Upstash, Redis Cloud, or local Docker)
# Used by BullMQ for background task coordination and SSE progress broadcasting.
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# OBJECT STORAGE (Cloudflare R2 / AWS S3 / Supabase Storage / MinIO / Vercel Blob)
# Required in production for video/audio assets, fonts, preview SVGs, and exports.
# In local development without keys, local filesystem data/storage/ is used.
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="viralclip-assets"
STORAGE_ACCESS_KEY="your_s3_or_r2_access_key_id"
STORAGE_SECRET_KEY="your_s3_or_r2_secret_access_key"
STORAGE_PUBLIC_URL="https://assets.viralclip.studio"
STORAGE_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# DEDICATED PROCESSING WORKER (Railway, Render, Fly.io, Modal, RunPod, AWS ECS, VPS)
# When WORKER_URL is configured, heavy processing (FFmpeg, Whisper, Drive batch imports)
# is dispatched to the external worker. If empty, local processing is used.
# ------------------------------------------------------------------------------
WORKER_URL="http://localhost:3002"
WORKER_SECRET="generate_a_secure_random_worker_secret_key"
WORKER_PORT=3002
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# GOOGLE DRIVE IMPORTER & OAUTH (Server-Side Authentication)
# Never expose client secrets or service account keys to the browser.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
GOOGLE_DRIVE_API_KEY=""

# ------------------------------------------------------------------------------
# TOOLING & BINARY PATHS (Worker Host Environment)
# ------------------------------------------------------------------------------
YT_DLP_PATH="yt-dlp"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# ------------------------------------------------------------------------------
# SPEECH-TO-TEXT & AUDIO
# Model options: tiny, base, small, medium (default: base)
# ------------------------------------------------------------------------------
WHISPER_MODEL="base"

# ------------------------------------------------------------------------------
# AI & STOCK MEDIA PROVIDERS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
PINTEREST_ACCESS_TOKEN=""
HEYGEN_API_KEY=""

# ------------------------------------------------------------------------------
# AUTH & SECURITY
# ------------------------------------------------------------------------------
AUTH_SECRET="generate_a_secure_session_encryption_secret"
JWT_SECRET="generate_a_secure_jwt_signing_secret"
WATERMARK_ENABLED=false
