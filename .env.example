# ==============================================================================
# VIRALCLIP STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Target Architecture: Vercel (Frontend & Orchestration) + PostgreSQL + S3 Object Storage + Dedicated Worker
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"
VITE_API_BASE_URL=""
VITE_APP_TITLE="ViralClip Studio"

# Database (PostgreSQL - Neon, Supabase, AWS RDS, or local Docker)
DATABASE_URL="postgresql://postgres:postgres_secret_password@localhost:5432/viralclip_studio?sslmode=prefer"

# Queue & Cache (Redis - Upstash, Redis Cloud, or local Docker)
REDIS_URL="redis://localhost:6379/0"

# Object Storage (S3 / Cloudflare R2 / Supabase Storage / MinIO)
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="viralclip-media"
STORAGE_ACCESS_KEY="your_s3_or_r2_access_key_id"
STORAGE_SECRET_KEY="your_s3_or_r2_secret_access_key"
STORAGE_PUBLIC_URL=""
STORAGE_FORCE_PATH_STYLE=false

# Dedicated Processing Worker (Railway, Render, Fly.io, AWS ECS, Docker)
WORKER_URL="http://localhost:3002"
WORKER_SECRET="generate_a_secure_random_worker_secret_key"
WORKER_PORT=3002
WORKER_CONCURRENCY=2

# Tooling Paths (Worker Environment)
YT_DLP_PATH="yt-dlp"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Speech-to-Text (Local Whisper ONNX Model: tiny, base, small, medium)
WHISPER_MODEL="base"

# Media Quality & Branding
WATERMARK_ENABLED=false

# AI & Stock Media Providers
GEMINI_API_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
PINTEREST_ACCESS_TOKEN=""

# Auth & Session Secrets
AUTH_SECRET="generate_a_secure_session_encryption_secret"
JWT_SECRET="generate_a_secure_jwt_signing_secret"
